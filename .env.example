# ─── API ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true                  # false en production
API_RATE_LIMIT=100               # nb requêtes/minute
LOG_LEVEL=info                   # debug, info, warning, error

# ─── MODÈLES ─────────────────────────────────────────────────────
MODELS_DIR=./models
DEFAULT_MODEL=random_forest
ARTIFACTS_DIR=./data/artifacts

# ─── SEUILS ML ───────────────────────────────────────────────────
R2_THRESHOLD=0.80                # ex: 0.80 = le modèle doit scorer > 80%
MAPE_PRODUCTION_THRESHOLD=10.0   # ex: 10.0 = erreur max tolérée en %

# ─── PIPELINE ────────────────────────────────────────────────────
DATA_SOURCE=local                # "local" pour tester sans Snowflake
DATA_DIR=./data
FORCE_SNOWFLAKE_WRITE=false      # true = écrit les résultats dans Snowflake

# ─── MLFLOW ──────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=edf-consumption

# ─── SNOWFLAKE (laisser vide si DATA_SOURCE=local) ───────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=EDF
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# ─── AZURE STORAGE (laisser vide pour tester en local) ───────────
USE_AZURE_STORAGE=false
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_ARTIFACTS=mlflow-artifacts